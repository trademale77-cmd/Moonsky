<style>
  :root{
    --black:#0B0B0C;
    --ink:#171717;
    --graphite:#3A3A3D;
    --steel:#8B8B8E;
    --line:#DEDEDA;
    --line-strong:#B8B8B4;
    --paper:#FAFAF8;
    --white:#FFFFFF;
    --secondary:#3A3A3D;
    --accent:#171717;
    --radius:2px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',system-ui,sans-serif;
    -webkit-font-smoothing:antialiased;
    padding-bottom:96px;
  }
  h1,h2,h3,.display{
    font-family:'Space Grotesk',system-ui,sans-serif;
    font-weight:700;
    margin:0;
    letter-spacing:-0.01em;
  }
  .mono{
    font-family:'JetBrains Mono',ui-monospace,monospace;
  }
  a{color:inherit;}
  button{font-family:inherit;cursor:pointer;}
  img{max-width:100%;display:block;}

  @keyframes fadeUp{
    from{opacity:0; transform:translateY(10px);}
    to{opacity:1; transform:translateY(0);}
  }
  @keyframes fadeIn{
    from{opacity:0;}
    to{opacity:1;}
  }
  @keyframes pulseRing{
    0%{box-shadow:0 0 0 0 rgba(11,11,12,0.25);}
    100%{box-shadow:0 0 0 7px rgba(11,11,12,0);}
  }
  @keyframes badgeBump{
    0%{transform:scale(1);}
    35%{transform:scale(1.35);}
    100%{transform:scale(1);}
  }
  @keyframes scan{
    from{transform:translateY(-100%);}
    to{transform:translateY(100%);}
  }
  @keyframes floatShoeA{
    0%{transform:translate(0,0) rotate(-8deg);}
    50%{transform:translate(18px,-16px) rotate(3deg);}
    100%{transform:translate(0,0) rotate(-8deg);}
  }
  @keyframes floatShoeB{
    0%{transform:translate(0,0) rotate(6deg) scaleX(-1);}
    50%{transform:translate(-14px,-20px) rotate(-4deg) scaleX(-1);}
    100%{transform:translate(0,0) rotate(6deg) scaleX(-1);}
  }
  @keyframes floatShoeC{
    0%{transform:translate(0,0) rotate(-3deg);}
    50%{transform:translate(10px,-10px) rotate(7deg);}
    100%{transform:translate(0,0) rotate(-3deg);}
  }

  /* ---------- Top status bar ---------- */
  .status-bar{
    background:var(--black);
    color:var(--paper);
    font-family:'JetBrains Mono',monospace;
    font-size:11px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    padding:7px 18px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    animation:fadeIn .4s ease both;
  }
  .status-dot{
    display:inline-block;
    width:6px;height:6px;
    border-radius:50%;
    background:#4ADE80;
    margin-right:6px;
    animation:pulseRing 1.8s infinite;
  }
  .status-bar span.muted{color:#8B8B8E;}

  /* ---------- Header ---------- */
  header.shop-header{
    position:sticky;
    top:0;
    z-index:35;
    background:linear-gradient(120deg, var(--ink) 0%, var(--graphite) 100%);
    border-bottom:1px solid var(--line);
    padding:16px 18px;
    transition:box-shadow .2s ease, padding .2s ease;
  }
  header.shop-header.scrolled{
    box-shadow:0 4px 18px rgba(32,34,58,0.25);
    padding:10px 18px;
  }
  .shop-header-inner{
    max-width:1040px;
    margin:0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    flex-wrap:wrap;
    animation:fadeUp .5s ease both;
  }
  .brand-block{display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
  .shop-logo{width:26px; height:26px; flex:0 0 auto;}
  .shop-name{
    font-size:clamp(19px,4vw,25px);
    text-transform:uppercase;
    letter-spacing:0.01em;
    color:var(--white);
  }
  .shop-tagline{
    font-size:12.5px;
    color:#C7CBEF;
    font-family:'JetBrains Mono',monospace;
  }
  .header-actions{display:flex; align-items:center; gap:10px;}
  .icon-btn{
    border:1px solid var(--accent);
    background:transparent;
    color:var(--accent);
    width:40px;height:40px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:17px;
    text-decoration:none;
    transition:background .15s ease, color .15s ease, transform .12s ease;
  }
  .icon-btn:hover{background:var(--accent); color:var(--ink);}
  .icon-btn.has-saved{background:var(--black); color:#fff;}
  .icon-btn:active{transform:scale(0.94);}

  /* ---------- Hero band: floating shoe animation ---------- */
  .hero-band{
    position:relative;
    overflow:hidden;
    height:150px;
    background:linear-gradient(120deg, var(--black) 0%, var(--secondary) 55%, var(--accent) 100%);
    border-bottom:1px solid var(--line);
  }
  .hero-band-label{
    position:relative;
    z-index:2;
    max-width:1040px;
    margin:0 auto;
    height:100%;
    display:flex;
    align-items:center;
    padding:0 18px;
    pointer-events:none;
  }
  .hero-band-label span{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:15px;
    letter-spacing:0.02em;
    text-transform:uppercase;
    color:#FFFFFF;
    text-shadow:0 2px 10px rgba(0,0,0,0.25);
  }
  .floating-shoe{
    position:absolute;
    opacity:0.95;
    z-index:1;
    pointer-events:none;
    filter:drop-shadow(0 8px 14px rgba(0,0,0,0.28));
  }
  .hero-shoe-img{
    width:100%;
    border-radius:50%;
    border:2px solid rgba(255,255,255,0.85);
    display:block;
    aspect-ratio:1/1;
    object-fit:cover;
    filter:grayscale(1);
  }
  .shoe-1{ top:14px; left:8%; width:64px; animation:floatShoeA 7s ease-in-out infinite; }
  .shoe-2{ top:56px; left:38%; width:52px; opacity:0.85; animation:floatShoeB 9s ease-in-out infinite; animation-delay:1.2s; }
  .shoe-3{ top:22px; left:68%; width:80px; opacity:0.95; animation:floatShoeC 8s ease-in-out infinite; animation-delay:0.6s; }
  .shoe-4{ top:78px; left:88%; width:48px; opacity:0.8; animation:floatShoeA 10s ease-in-out infinite; animation-delay:2s; }
  @media (max-width:640px){
    .hero-band{height:130px;}
    .shoe-3{display:none;}
    .shoe-4{display:none;}
  }

  /* ---------- Fixed background flying shoes (parallax on scroll) ---------- */
  .shoe-bg-layer{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:-1;
    overflow:hidden;
  }
  .bg-shoe{
    position:absolute;
    opacity:0.22;
    filter:drop-shadow(0 10px 16px rgba(32,34,58,0.18));
    will-change:transform;
  }
  .bg-shoe-float{width:100%;}
  .bg-shoe-img{
    width:100%;
    border-radius:50%;
    display:block;
    aspect-ratio:1/1;
    object-fit:cover;
    filter:grayscale(1);
  }

  /* ---------- Search bar ---------- */
  .search-bar-wrap{
    max-width:1040px;
    margin:16px auto 0;
    padding:0 18px;
    position:relative;
    display:flex;
    align-items:center;
  }
  .search-icon{
    position:absolute;
    left:30px;
    font-size:14px;
    pointer-events:none;
    opacity:0.6;
  }
  .search-input{
    width:100%;
    border:1.5px solid var(--line-strong);
    border-radius:var(--radius);
    padding:11px 40px;
    font-size:14px;
    font-family:'Inter',sans-serif;
    background:var(--white);
    color:var(--ink);
    transition:border-color .15s ease;
  }
  .search-input:focus{outline:none; border-color:var(--black);}
  .search-clear{
    position:absolute;
    right:30px;
    background:none;
    border:none;
    color:var(--steel);
    font-size:14px;
    padding:4px;
  }
  .search-clear:hover{color:var(--black);}

  /* ---------- Category filter (underline tabs) ---------- */
  .cat-bar{
    max-width:1040px;
    margin:0 auto;
    padding:14px 18px 0;
    display:flex;
    gap:22px;
    overflow-x:auto;
    scrollbar-width:none;
    border-bottom:1px solid var(--line);
  }
  .cat-bar::-webkit-scrollbar{display:none;}
  .cat-tab{
    flex:0 0 auto;
    background:none;
    border:none;
    color:var(--steel);
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    letter-spacing:0.05em;
    text-transform:uppercase;
    padding:0 0 12px;
    position:relative;
    transition:color .15s ease;
  }
  .cat-tab::after{
    content:"";
    position:absolute;
    left:0; right:0; bottom:-1px;
    height:2px;
    background:var(--black);
    transform:scaleX(0);
    transform-origin:left;
    transition:transform .2s ease;
  }
  .cat-tab.active{color:var(--black); font-weight:600;}
  .cat-tab.active::after{transform:scaleX(1);}
  .cat-tab:hover{color:var(--ink);}

  /* ---------- Product grid ---------- */
  main{
    max-width:1040px;
    margin:0 auto;
    padding:24px 18px 10px;
  }
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(160px,1fr));
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .card{
    background:var(--white);
    display:flex;
    flex-direction:column;
    opacity:0;
    transform:translateY(14px);
    transition:opacity .5s ease, transform .5s ease;
  }
  .card.in-view{opacity:1; transform:translateY(0);}
  .card-img-wrap{
    aspect-ratio:1/1;
    background:#EDEDEA;
    overflow:hidden;
    position:relative;
  }
  .card-img-wrap img{
    width:100%;height:100%;object-fit:cover;
    filter:grayscale(1) contrast(1.05);
    transform:scale(1.02);
    transition:transform .5s cubic-bezier(.2,.7,.2,1), filter .3s ease;
  }
  .card:hover .card-img-wrap img{transform:scale(1.09);}
  .sku-tag{
    position:absolute;
    top:8px; left:8px;
    background:var(--black);
    color:var(--paper);
    font-family:'JetBrains Mono',monospace;
    font-size:10px;
    letter-spacing:0.05em;
    padding:2px 6px;
  }
  .attitude-badge{
    position:absolute;
    top:10px; right:-6px;
    background:var(--black);
    color:#fff;
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:10.5px;
    letter-spacing:0.03em;
    text-transform:uppercase;
    padding:4px 12px 4px 10px;
    transform:rotate(6deg);
    box-shadow:0 4px 10px rgba(11,11,12,0.35);
    z-index:2;
  }
  .wishlist-heart{
    position:absolute;
    bottom:8px; right:8px;
    width:30px; height:30px;
    border-radius:50%;
    background:rgba(255,255,255,0.92);
    border:1px solid var(--line-strong);
    color:var(--ink);
    font-size:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:2;
    transition:transform .12s ease, background .15s ease, color .15s ease;
  }
  .wishlist-heart:hover{transform:scale(1.1);}
  .wishlist-heart:active{transform:scale(0.9);}
  .wishlist-heart.saved{background:var(--black); color:#fff; border-color:var(--black);}
  .card{cursor:pointer;}

  /* ---------- Product Detail Page ---------- */
  .pdp-page{
    position:fixed;
    inset:0;
    background:var(--paper);
    z-index:75;
    display:flex;
    flex-direction:column;
    transform:translateX(100%);
    transition:transform .3s cubic-bezier(.2,.8,.25,1);
  }
  .pdp-page.show{transform:translateX(0);}
  .pdp-topbar{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:14px 16px;
    border-bottom:1px solid var(--line);
    background:var(--white);
  }
  .pdp-back{
    background:none;
    border:none;
    font-size:14px;
    font-weight:700;
    color:var(--ink);
    padding:6px 4px;
  }
  .pdp-topbar-sku{font-size:11px; color:var(--steel);}
  .pdp-scroll{
    flex:1;
    overflow-y:auto;
    -webkit-overflow-scrolling:touch;
  }
  .pdp-gallery{
    background:var(--white);
    border-bottom:1px solid var(--line);
    padding-bottom:14px;
  }
  .pdp-main-img-wrap{
    position:relative;
    width:100%;
    aspect-ratio:1/1;
    background:#EDEDEA;
    overflow:hidden;
  }
  .pdp-main-img{
    width:100%; height:100%;
    object-fit:cover;
    filter:grayscale(1) contrast(1.05);
  }
  .pdp-heart{
    top:12px; right:12px; bottom:auto;
    width:38px; height:38px;
    font-size:19px;
    z-index:3;
  }
  .pdp-thumbs{
    display:flex;
    gap:8px;
    padding:12px 16px 0;
    overflow-x:auto;
  }
  .pdp-thumb{
    flex:0 0 auto;
    width:56px; height:56px;
    border-radius:4px;
    overflow:hidden;
    border:2px solid transparent;
    opacity:0.6;
    transition:opacity .15s ease, border-color .15s ease;
  }
  .pdp-thumb img{width:100%; height:100%; object-fit:cover; filter:grayscale(1);}
  .pdp-thumb.active{border-color:var(--black); opacity:1;}
  .pdp-info{padding:18px 16px 24px;}
  .pdp-name{
    font-size:19px;
    line-height:1.3;
    margin:6px 0 8px;
  }
  .pdp-badge-row{margin-bottom:6px;}
  .pdp-badge-row .attitude-badge{
    position:static;
    display:inline-block;
    transform:none;
    margin-bottom:4px;
  }
  .pdp-price{
    font-family:'JetBrains Mono',monospace;
    font-weight:700;
    font-size:24px;
    color:var(--black);
    margin-bottom:18px;
  }
  .pdp-section{
    border-top:1px solid var(--line);
    padding-top:14px;
    margin-top:14px;
  }
  .pdp-section-title{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--steel);
    margin-bottom:8px;
  }
  .pdp-desc{
    font-size:13.5px;
    line-height:1.6;
    color:var(--graphite);
  }
  .pdp-info-rows{
    margin:0;
    padding:0;
    list-style:none;
  }
  .pdp-info-rows li{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:13px;
    color:var(--graphite);
    padding:7px 0;
    border-bottom:1px dashed var(--line);
  }
  .pdp-info-rows li:last-child{border-bottom:none;}
  .pdp-info-icon{
    font-size:15px;
    width:22px;
    text-align:center;
    flex:0 0 auto;
  }
  .pdp-buybar{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    padding:12px 16px;
    background:var(--white);
    border-top:1px solid var(--line);
  }
  .pdp-buybar-qty{width:100%;}
  .pdp-buybar-qty .add-btn{width:100%; padding:14px; font-size:13px;}
  .pdp-buybar-qty .stepper{width:100%; justify-content:center; padding:12px;}

  .card-body{
    padding:11px 12px 13px;
    display:flex;
    flex-direction:column;
    gap:4px;
    flex:1;
    border-top:1px solid var(--line);
  }
  .card-cat{
    font-family:'JetBrains Mono',monospace;
    font-size:9.5px;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--steel);
  }
  .card-name{
    font-size:14px;
    font-weight:600;
    line-height:1.25;
    color:var(--ink);
  }
  .card-desc{
    font-size:11.5px;
    color:var(--steel);
    line-height:1.3;
    flex:1;
  }
  .card-footer{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-top:7px;
    gap:6px;
  }
  .price{
    font-family:'JetBrains Mono',monospace;
    font-weight:600;
    font-size:14.5px;
    color:var(--black);
  }
  .add-btn{
    background:var(--black);
    color:var(--white);
    border:1px solid var(--black);
    border-radius:var(--radius);
    padding:8px 12px;
    font-size:11.5px;
    font-weight:600;
    letter-spacing:0.03em;
    text-transform:uppercase;
    transition:transform .12s ease, background .15s ease, color .15s ease;
    overflow:hidden;
    position:relative;
  }
  .add-btn:hover{background:var(--white); color:var(--black);}
  .add-btn:active{transform:scale(0.94);}
  .add-btn.added{background:var(--white); color:var(--black);}
  .stepper{
    display:flex;
    align-items:center;
    gap:9px;
    background:var(--black);
    border:1px solid var(--black);
    border-radius:var(--radius);
    padding:5px 8px;
  }
  .stepper button{
    background:none;
    border:none;
    color:var(--white);
    font-size:15px;
    font-weight:700;
    width:18px;
    height:18px;
    line-height:1;
    transition:opacity .12s ease;
  }
  .stepper button:hover{opacity:0.6;}
  .stepper span{color:var(--white); font-weight:600; font-size:12.5px; min-width:12px; text-align:center; font-family:'JetBrains Mono',monospace;}

  .empty-msg{
    text-align:center;
    color:var(--steel);
    padding:44px 10px;
    font-size:13px;
    font-family:'JetBrains Mono',monospace;
  }

  /* ---------- Sticky cart button ---------- */
  .cart-fab{
    position:fixed;
    right:16px;
    bottom:16px;
    background:var(--black);
    color:var(--white);
    border:1px solid var(--black);
    border-radius:var(--radius);
    padding:14px 18px;
    display:flex;
    align-items:center;
    gap:10px;
    box-shadow:0 10px 26px rgba(11,11,12,0.28);
    font-weight:600;
    font-size:13px;
    letter-spacing:0.03em;
    text-transform:uppercase;
    z-index:40;
    transition:transform .15s ease;
  }
  .cart-fab:hover{transform:translateY(-2px);}
  .cart-fab:active{transform:scale(0.96);}
  .cart-fab .badge{
    background:var(--white);
    color:var(--black);
    border-radius:999px;
    min-width:20px;
    height:20px;
    font-size:11px;
    font-family:'JetBrains Mono',monospace;
    display:flex;
